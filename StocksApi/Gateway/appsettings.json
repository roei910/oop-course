{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "stock-route-getall": {
        "ClusterId": "stocks-cluster",
        "Match": {
          "Path": "/api/stock"
        }
      },
      "stock-route-symbol": {
        "ClusterId": "stocks-cluster",
        "Match": {
          "Path": "/api/stock/symbol/{**catch-all}"
        }
      },
      "stock-route-find": {
        "ClusterId": "stocks-cluster",
        "Match": {
          "Path": "/api/stock/find/{**catch-all}"
        }
      },
      "stock-route-marketTrends": {
        "ClusterId": "stocks-cluster",
        "Match": {
          "Path": "/api/stock/marketTrends"
        }
      },
      "stock-route-force-update": {
        "ClusterId": "stocks-cluster",
        "Match": {
          "Path": "/api/stock/force-update-all-stocks"
        }
      },
      "user-route-get": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/user"
        }
      },
      "user-route-all": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/user/all"
        }
      },
      "user-route-connect": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/user/connect-user"
        }
      },
      "user-route-register": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/user/register"
        }
      },
      "user-route-update-password": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/user/update-password"
        }
      },
      "share-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/share/{**catch-all}"
        }
      },
      "userStockWatch-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/userStockWatch/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "stocks-cluster": {
        "Destinations": {
          "stocks-service": {
            "Address": "http://stocks-service/"
          }
        }
      },
      "users-cluster": {
        "Destinations": {
          "users-service": {
            "Address": "http://users-service/"
          }
        }
      }
    }
  }
}
