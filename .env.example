# ============================================
# Database Provider Configuration
# Options: SQLite | PostgreSQL
# ============================================
DatabaseProvider=SQLite

# ============================================
# SQLite Connection Strings (Default)
# ============================================
FINANCIALDATA_CONNECTION_STRING=Data Source=/data/FinancialData.db
USERS_CONNECTION_STRING=Data Source=/data/Users.db
WEBHOOK_CONNECTION_STRING=Data Source=/data/Webhook.db

# ============================================
# PostgreSQL Connection Strings
# Uncomment when DatabaseProvider=PostgreSQL
# ============================================
# FINANCIALDATA_CONNECTION_STRING=Host=postgres;Port=5432;Database=FinancialData;Username=financegrid;Password=changeme
# USERS_CONNECTION_STRING=Host=postgres;Port=5432;Database=Users;Username=financegrid;Password=changeme
# WEBHOOK_CONNECTION_STRING=Host=postgres;Port=5432;Database=Webhook;Username=financegrid;Password=changeme

# ============================================
# PostgreSQL Service Credentials
# CHANGE THESE BEFORE PRODUCTION USE!
# ============================================
POSTGRES_USER=financegrid
POSTGRES_PASSWORD=changeme
POSTGRES_DB=financegrid