# ============================================
# Database Provider Configuration
# Options: SQLite | PostgreSQL
# ============================================
DatabaseProvider=SQLite

# ============================================
# SQLite Connection Strings (Default)
# ============================================
FINANCIALDATA_CONNECTION_STRING=Data Source=/data/FinancialData.db
USERS_CONNECTION_STRING=Data Source=/data/Users.db
WEBHOOK_CONNECTION_STRING=Data Source=/data/Webhook.db

# ============================================
# PostgreSQL Connection Strings
# Uncomment when DATABASE_PROVIDER=PostgreSQL
# ============================================
# FINANCIALDATA_CONNECTION_STRING=Host=postgres;Port=5432;Database=FinancialData;Username=financegrid;Password=financegrid
# USERS_CONNECTION_STRING=Host=postgres;Port=5432;Database=Users;Username=financegrid;Password=financegrid
# WEBHOOK_CONNECTION_STRING=Host=postgres;Port=5432;Database=Webhook;Username=financegrid;Password=financegrid

# ============================================
# PostgreSQL Service Credentials
# ============================================
POSTGRES_USER=financegrid
POSTGRES_PASSWORD=financegrid
POSTGRES_DB=financegrid
